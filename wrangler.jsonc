{
  // Must match the EXISTING worker exactly. A different name creates a second
  // worker with no routes attached, so the live site would keep serving the
  // old code while the deploy looks like it succeeded.
  "name": "kamal-api",

  "main": "worker.js",
  "compatibility_date": "2024-09-23",

  // Both routes are declared on purpose. The worker serves the API *and* the
  // R2 photos, and omitting a route it currently answers risks dropping it on
  // deploy — which would take down images or the whole backend.
  "routes": [
    { "pattern": "kamaljewellers.shop/api/*", "zone_name": "kamaljewellers.shop" },
    { "pattern": "kamaljewellers.shop/photos/*", "zone_name": "kamaljewellers.shop" }
  ],

  // What the code actually talks to: env.KV, env.DB, env.PHOTOS. An earlier
  // version of this file declared none of these, which would have deployed a
  // worker with all three undefined and broken saving, leads and photos.
  "kv_namespaces": [
    { "binding": "KV", "id": "2711d8dbb43a400bb7bfa7dd03c739f9" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kamal-jewellers",
      "database_id": "b23cff2f-3140-45bb-8a4f-13d48d8d2402"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "kamal-photos" }
  ]
}
