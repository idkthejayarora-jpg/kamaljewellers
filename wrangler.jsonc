{
  // ⚠️ SET THIS to the exact name of your EXISTING worker.
  //
  // Find it at: Cloudflare dashboard → Workers & Pages → the worker serving
  // kamaljewellers.shop/api/* → its name is at the top of that page.
  //
  // The name must be lowercase letters, numbers and dashes only — no spaces.
  // It was previously "kamal jewellers website", which wrangler rejects, and
  // that is the error you hit.
  //
  // Getting this wrong is worse than a failed deploy: a name that doesn't
  // match an existing worker CREATES A NEW ONE, which won't be attached to
  // your /api/* route, so the live site would carry on running the old code
  // while everything looks like it deployed fine.
  "name": "REPLACE-WITH-YOUR-WORKER-NAME",

  "main": "worker.js",
  "compatibility_date": "2024-09-23",

  // These three bindings are what the code actually talks to. The version of
  // this file created earlier had none of them, so a deploy would have left
  // env.KV, env.DB and env.PHOTOS undefined — breaking content loading and
  // saving, the leads inbox and photo uploads on a site that currently works.
  // Values copied from worker-meta.json.
  "kv_namespaces": [
    { "binding": "KV", "id": "2711d8dbb43a400bb7bfa7dd03c739f9" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_id": "b23cff2f-3140-45bb-8a4f-13d48d8d2402" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "kamal-photos" }
  ]
}
